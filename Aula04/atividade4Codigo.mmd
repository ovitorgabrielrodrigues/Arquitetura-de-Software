classDiagram
    namespace Apresentacao {
        class PedidoController {
            +criarPedido(dto: PedidoDTO) Resposta
        }
    }

    namespace Aplicacao {
        class RegistrarPedidoUseCase {
            +executar(dados: PedidoDTO) Pedido
        }
    }

    namespace Dominio {
        class Pedido {
            -id: String
            -itens: List~ItemPedido~
            -valorTotal: Decimal
            +calcularTotal() Decimal
            +validar() Boolean
        }
        class Estoque {
            -produtoId: String
            -quantidade: Integer
            +baixarQuantidade(qtd: Integer) Boolean
            +adicionarQuantidade(qtd: Integer) Void
        }
        class IPedidoRepository {
            <<interface>>
            +salvar(pedido: Pedido) Void
        }
        class IEstoqueRepository {
            <<interface>>
            +buscarPorProdutoId(id: String) Estoque
            +atualizar(estoque: Estoque) Void
        }
    }

    namespace Infraestrutura {
        class PedidoRepositoryImpl {
            +salvar(pedido: Pedido) Void
        }
        class EstoqueRepositoryImpl {
            +buscarPorProdutoId(id: String) Estoque
            +atualizar(estoque: Estoque) Void
        }
    }

    PedidoController --> RegistrarPedidoUseCase
    RegistrarPedidoUseCase --> Pedido
    RegistrarPedidoUseCase --> IPedidoRepository
    RegistrarPedidoUseCase --> IEstoqueRepository
    IPedidoRepository <|.. PedidoRepositoryImpl
    IEstoqueRepository <|.. EstoqueRepositoryImpl
    Pedido ..> Estoque : solicita baixa